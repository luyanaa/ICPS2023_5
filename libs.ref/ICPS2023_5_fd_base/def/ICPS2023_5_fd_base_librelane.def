# LibreLane alias view: M1 maps to physical design layer ML1 (GDS 8/0).
VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN ICPS2023_5_fd_base ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( -800000 -800000 ) ( 800000 800000 ) ;

PINS 28 ;
- PAD_00 + NET PAD_00 + DIRECTION INOUT + USE SIGNAL
  + PORT
    + LAYER M1 ( 0 0 ) ( 60000 60000 )
    + FIXED ( -730000 690000 ) N ;
