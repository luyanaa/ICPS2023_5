VERSION 5.8 ;
MACRO INV_X1
  CLASS CORE ;
  ORIGIN 0 0 ;
  SIZE 78 BY 160 ;
  PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER ML1 ;
        RECT 32.5 100 45.5 113 ;
        RECT 32.5 44 45.5 57 ;
    END
  END A
  PIN Y
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER ML1 ;
        RECT 50 76.5 63 89.5 ;
        RECT 50 20.5 63 33.5 ;
    END
  END Y
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER ML1 ;
        RECT 15 76.5 28 89.5 ;
    END
  END VDD
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER ML1 ;
        RECT 15 20.5 28 33.5 ;
    END
  END VSS
  OBS
    LAYER ML1 ;
      RECT 53.5 24 59.5 86 ;
  END
END INV_X1
